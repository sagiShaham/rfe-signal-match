# RFE Signal Match — example environment file
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ── RFE Mail Broker ───────────────────────────────────────────────────────────
# Server-side only. These keys must NEVER reach the browser or be committed.
# Recipients may be on any domain. Submitting only stages a batch — the broker's
# review portal still has to approve it before anything is delivered.
RFE_BROKER_BASE_URL=https://func-rfe-notif-prd-1791a.azurewebsites.net/api
RFE_BROKER_SUBMIT_KEY=replace-with-submit-function-key
RFE_BROKER_STATUS_KEY=replace-with-status-function-key
# Master on/off switch for broker sending from the platform.
RFE_BROKER_TEST_MODE=true

# ── Optional: AI email/summaries ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=

# NOTE: SMTP_* and GRAPH_* mail-sending settings were removed along with the
# direct-send endpoints. All email now goes through the RFE Mail Broker above,
# where a reviewer must approve a batch before it is delivered. Do not add a
# direct-send path back.

# ── Optional: Salesforce live pull ────────────────────────────────────────────
# SF_USERNAME=
# SF_PASSWORD=
# SF_SECURITY_TOKEN=
